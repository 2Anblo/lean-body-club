# Copy to server/.env for local development. Never commit the real .env.

# MongoDB connection string. Local: mongodb://127.0.0.1:27017/lean-body-club
# Production: a MongoDB Atlas URI (mongodb+srv://...).
MONGODB_URI=mongodb://127.0.0.1:27017/lean-body-club

# Port the API listens on. The client's Vite dev server forwards /api/* to 4000.
PORT=4000

# Comma-separated origins allowed to call the API from a browser.
CORS_ORIGINS=http://localhost:5173,https://2anblo.github.io

# How long a sign-in lasts before the user has to sign in again.
SESSION_TTL_DAYS=30

# Sign-up / sign-in attempts allowed per IP address per 15 minutes.
AUTH_RATE_LIMIT=20

# bcrypt cost factor. 10-12 is typical; higher is slower and stronger.
BCRYPT_ROUNDS=11
