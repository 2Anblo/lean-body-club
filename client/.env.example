# Copy to .env to change how the client gets its data.

# "mock" (default): everything is stored in this browser's localStorage, with demo data.
# "http": call the real backend (see docs/api.md).
VITE_API_MODE=mock

# Base URL of the REST API in http mode. In development, "/api" is forwarded to http://localhost:4000.
VITE_API_URL=/api
